    "PREMIUM_ENDING_7_DAYS": { "minDays": 2, "maxDays": 7, "minAccessAgeDays": 3 },
    "PREMIUM_ENDING_2_DAYS": { "minDays": 0, "maxDays": 2, "minAccessAgeDays": 0 },
