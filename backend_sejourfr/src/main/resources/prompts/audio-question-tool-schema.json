{
  "type": "object",
  "additionalProperties": false,
  "required": ["audio", "question", "choices"],
  "properties": {
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript", "ssml", "speakerCount", "voices", "estimatedDurationSec", "contextDescription"],
      "properties": {
        "transcript": {
          "type": "string",
          "minLength": 30,
          "maxLength": 5000,
          "description": "Texte brut a faire prononcer, sans balise SSML. Doit etre identique mot pour mot au texte effectif du SSML (hors balises)."
        },
        "ssml": {
          "type": "string",
          "minLength": 60,
          "maxLength": 8000,
          "description": "SSML valide commencant par <speak version=\"1.0\" xml:lang=\"fr-FR\"> et finissant par </speak>. Chaque locuteur dans une balise <voice name=\"fr-FR-XxxNeural\">."
        },
        "speakerCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Doit etre egal a la longueur de voices."
        },
        "voices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "azureVoice", "gender"],
            "properties": {
              "role": { "type": "string", "minLength": 1, "maxLength": 64 },
              "azureVoice": {
                "type": "string",
                "enum": [
                  "fr-FR-DeniseNeural",
                  "fr-FR-EloiseNeural",
                  "fr-FR-CelesteNeural",
                  "fr-FR-BrigitteNeural",
                  "fr-FR-YvetteNeural",
                  "fr-FR-CoralieNeural",
                  "fr-FR-VivienneNeural",
                  "fr-FR-JosephineNeural",
                  "fr-FR-MauriceNeural",
                  "fr-FR-JeromeNeural",
                  "fr-FR-YvesNeural",
                  "fr-FR-HenriNeural",
                  "fr-FR-AlainNeural",
                  "fr-FR-ClaudeNeural"
                ]
              },
              "gender": { "type": "string", "enum": ["F", "M"] }
            }
          }
        },
        "estimatedDurationSec": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "contextDescription": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "Description breve de la situation, affichee a l'admin avant lecture."
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "explanation", "competenceCode", "difficulty", "themeSuggested"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "explanation": {
          "type": "string",
          "minLength": 50,
          "maxLength": 1500,
          "description": "Structure en 2 temps : 1) justifier la bonne reponse en citant le transcript entre guillemets francais ; 2) eliminer les distracteurs."
        },
        "competenceCode": {
          "type": "string",
          "enum": [
            "co_reperage_explicite",
            "co_detail_specifique",
            "co_idee_principale",
            "co_inference_intention",
            "co_ton_attitude",
            "co_reformulation"
          ]
        },
        "difficulty": {
          "type": "string",
          "enum": ["A2", "B1", "B2"]
        },
        "themeSuggested": {
          "type": "string",
          "enum": [
            "vie_pratique_logement",
            "travail",
            "sante",
            "administratif",
            "transports",
            "consommation",
            "medias_numerique",
            "environnement"
          ]
        }
      }
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "isCorrect", "displayOrder"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "isCorrect": { "type": "boolean" },
          "displayOrder": { "type": "integer", "minimum": 1, "maximum": 4 }
        }
      }
    }
  }
}
