# Mobile SejourFR — template a copier en .env puis a remplir.
# `cp .env.example .env` et completer les valeurs en local.

API_BASE_URL=http://localhost:8080

# URL publique du site web SejourFR — utilisée par le mobile pour ouvrir
# en WebView les pages FAQ, CGU et Confidentialité (au lieu de les
# dupliquer en Dart natif). En dev : http://localhost:3000.
WEB_BASE_URL=https://sejourfr.fr

# Web client ID Google (Cloud Console > Credentials > OAuth Client > Web app)
GOOGLE_SERVER_CLIENT_ID=
# iOS client ID Google (Cloud Console > Credentials > OAuth Client > iOS app)
GOOGLE_IOS_CLIENT_ID=
